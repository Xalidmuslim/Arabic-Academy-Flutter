# Server only. Supply actual values using `supabase secrets set --env-file <private-file>`.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_ORIGINS=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Default refuses sandbox/test claims. Use true ONLY in a separate test deployment.
DEPLOYMENT_ENVIRONMENT=production
STORE_TEST_ENVIRONMENT=false
APPLE_BUNDLE_ID=
APPLE_APP_ID=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_P8=
# JSON array of Apple's trusted root CA PEM certificates, from Apple PKI.
APPLE_ROOT_CA_PEMS_JSON=
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
PURCHASE_WEBHOOK_HMAC_SECRET=
STT_OPENAI_API_KEY=
FCM_SERVICE_ACCOUNT_JSON=
ACCOUNT_CLEANUP_HMAC_SECRET=
