      "id": "bayna_print15_19_restored_20261121_001",
      "arabic": "أَصْلَحُ",
      "meaning_ar": "أَكْثَرُ صَلَاحًا وَنَفْعًا مِنْ غَيْرِهِ.",
      "additional_meanings_ar": [],
      "grammar": [
        "اِسْمُ تَفْضِيلٍ عَلَى وَزْنِ «أَفْعَلُ»، وَجَذْرُهُ: ص ـ ل ـ ح.",
        "يُسْتَعْمَلُ لِلْمُقَارَنَةِ، وَيَأْتِي مَعَ «مِنْ» لِذِكْرِ مَا يُقَارَنُ بِهِ؛ وَتَتَغَيَّرُ حَرَكَةُ آخِرِهِ بِحَسَبِ مَوْقِعِهِ الْإِعْرَابِيِّ.",
        "يُرَاعَى الْفَرْقُ بَيْنَ اسْمِ التَّفْضِيلِ «أَصْلَحُ» وَالْفِعْلِ الْمَاضِي «أَصْلَحَ»."
      ],
      "synonyms": [],
      "antonyms": [],
      "collocations": [
        "الْحَلُّ الْأَصْلَحُ",
        "أَصْلَحُ مِنْ غَيْرِهِ"
      ],
      "examples_ar": [
        "هَذَا الْحَلُّ أَصْلَحُ مِنْ غَيْرِهِ لِهَذِهِ الْمَسْأَلَةِ.",
        "اخْتَارَ الْمُعَلِّمُ الْوَقْتَ الْأَصْلَحَ لِلْمُرَاجَعَةِ."
      ],
      "usage_note_ar": "«أَصْلَحُ» اسْمُ تَفْضِيلٍ يَدُلُّ عَلَى زِيَادَةِ الصَّلَاحِ وَالنَّفْعِ، أَمَّا «أَصْلَحَ» فَفِعْلٌ مَاضٍ مَعْنَاهُ إِزَالَةُ الْخَلَلِ أَوِ الْفَسَادِ؛ وَلَا يُفْهَمُ هَذَا الْفَرْقُ مِنْ رَسْمِ الْحُرُوفِ بِدُونِ ضَبْطٍ.",
