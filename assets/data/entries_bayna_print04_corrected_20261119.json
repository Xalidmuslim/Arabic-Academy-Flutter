      "arabic": "أَجَّرَ",
      "meaning_ar": "جَعَلَ شَيْئًا تَحْتَ تَصَرُّفِ غَيْرِهِ لِمُدَّةٍ مُعَيَّنَةٍ مُقَابِلَ أُجْرَةٍ.",
      "additional_meanings_ar": [],
      "grammar": [
        "فِعْلٌ مَاضٍ مُزِيدٌ بِالتَّضْعِيفِ عَلَى وَزْنِ «فَعَّلَ»؛ جَذْرُهُ: أ ـ ج ـ ر.",
        "الْمُضَارِعُ: يُؤَجِّرُ؛ الْمَصْدَرُ: تَأْجِيرٌ؛ اسْمُ الْفَاعِلِ: مُؤَجِّرٌ؛ اسْمُ الْمَفْعُولِ: مُؤَجَّرٌ.",
        "فِعْلٌ مُتَعَدٍّ؛ يُقَالُ «أَجَّرَ بَيْتًا لِشَخْصٍ»."
      ],
      "synonyms": [],
      "antonyms": [],
      "collocations": [
