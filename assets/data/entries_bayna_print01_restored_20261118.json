      "id": "bayna_print01_restored_20261118_001",
      "arabic": "أَئِمَّةٌ",
      "meaning_ar": "جَمْعُ إِمَامٍ؛ وَالْإِمَامُ مَنْ يَتَقَدَّمُ النَّاسَ فِي الصَّلَاةِ أَوْ يُقْتَدَى بِهِ فِي شَأْنٍ.",
      "additional_meanings_ar": [],
      "grammar": [
        "اِسْمٌ؛ جَمْعُ تَكْسِيرٍ، مُفْرَدُهُ: إِمَامٌ، وَجَذْرُهُ: أ ـ م ـ م.",
        "يُرْفَعُ بِالضَّمَّةِ، وَيُنْصَبُ بِالْفَتْحَةِ، وَيُجَرُّ بِالْكَسْرَةِ."
      ],
      "synonyms": [],
      "antonyms": [],
      "collocations": [
        "أَئِمَّةُ الْمَسَاجِدِ"
      ],
      "examples_ar": [
        "يَقْتَدِي الْمُصَلُّونَ بِأَئِمَّةِ الْمَسَاجِدِ.",
        "اِجْتَمَعَ أَئِمَّةُ الْمَسَاجِدِ لِبَحْثِ شُؤُونِهَا."
      ],
      "usage_note_ar": "تُنْطَقُ الْهَمْزَةُ فِي أَوَّلِ «أَئِمَّةٌ»، وَتُشَدَّدُ الْمِيمُ. لَا تُخْلَطُ بِكَلِمَةِ «أُمَّةٌ».",
