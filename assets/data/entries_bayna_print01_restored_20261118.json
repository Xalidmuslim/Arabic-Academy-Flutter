      "arabic": "آبَاءٌ",
      "meaning_ar": "جَمْعُ أَبٍ؛ وَهُمُ الرِّجَالُ الَّذِينَ لَهُمْ أَبْنَاءٌ أَوْ بَنَاتٌ.",
      "additional_meanings_ar": [],
      "grammar": [
        "اِسْمٌ؛ جَمْعُ تَكْسِيرٍ لِـ«أَبٍ»، وَيُسْتَعْمَلُ لِلْمُذَكَّرِ.",
        "تُكْتَبُ الْهَمْزَةُ فِي آخِرِ الْجَمْعِ، وَيَبْدَأُ بِآلِفِ الْمَدِّ."
      ],
      "synonyms": [],
      "antonyms": [],
      "collocations": [
        "حُقُوقُ الْآبَاءِ"
      ],
      "examples_ar": [
