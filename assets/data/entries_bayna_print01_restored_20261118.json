    {
      "id": "bayna_print01_restored_20261118_003",
      "arabic": "إِبَاحَةٌ",
      "meaning_ar": "السَّمَاحُ بِالشَّيْءِ وَالْإِذْنُ بِفِعْلِهِ.",
      "additional_meanings_ar": [
        "حُكْمٌ شَرْعِيٌّ يَقْتَضِي التَّخْيِيرَ بَيْنَ الْفِعْلِ وَالتَّرْكِ، عِنْدَ الْأُصُولِيِّينَ."
      ],
      "grammar": [
        "اِسْمٌ مُؤَنَّثٌ؛ مَصْدَرُ «أَبَاحَ»، وَجَذْرُهُ: ب ـ و ـ ح.",
        "تُسْتَعْمَلُ «إِبَاحَةٌ» فِي مَعْنَى السَّمَاحِ، وَلَهَا مَعْنًى اصْطِلَاحِيٌّ مَخْصُوصٌ فِي أُصُولِ الْفِقْهِ."
      ],
      "synonyms": [
        "إِذْنٌ: فِي سِيَاقِ السَّمَاحِ بِفِعْلٍ مُعَيَّنٍ، لَا فِي جَمِيعِ الْمَعَانِي."
      ],
      "antonyms": [],
      "collocations": [
        "إِبَاحَةُ الدُّخُولِ"
      ],
      "examples_ar": [
        "أَعْلَنَتِ الْإِدَارَةُ إِبَاحَةَ الدُّخُولِ إِلَى الْمَكْتَبَةِ.",
        "تَدُلُّ الْإِبَاحَةُ فِي أُصُولِ الْفِقْهِ عَلَى التَّخْيِيرِ بَيْنَ الْفِعْلِ وَالتَّرْكِ."
      ],
      "usage_note_ar": "مَصْدَرُ «أَبَاحَ» هُوَ «إِبَاحَةٌ». فِي أُصُولِ الْفِقْهِ يَخْتَلِفُ مَعْنَاهَا الِاصْطِلَاحِيُّ عَنْ مُجَرَّدِ الْإِذْنِ الْإِدَارِيِّ.",
