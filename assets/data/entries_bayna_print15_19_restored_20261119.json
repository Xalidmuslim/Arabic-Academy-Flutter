      "id": "bayna_print15_19_restored_20261119_001",
      "arabic": "أَصْلَحُ",
      "meaning_ar": "أَكْثَرُ صَلَاحًا وَمَنْفَعَةً مِنْ غَيْرِهِ.",
      "additional_meanings_ar": [],
      "grammar": [
        "اِسْمُ تَفْضِيلٍ عَلَى وَزْنِ «أَفْعَلُ»، وَجَذْرُهُ: ص ـ ل ـ ح.",
        "يَدُلُّ عَلَى الْمُفَاضَلَةِ بَيْنَ شَيْئَيْنِ مِنْ جِهَةِ الصَّلَاحِ وَالنَّفْعِ، وَقَدْ يَأْتِي بَعْدَهُ حَرْفُ الْجَرِّ «مِنْ» لِلْمُقَارَنَةِ.",
        "فِي «هَذَا الْحَلُّ أَصْلَحُ»، يَكُونُ «أَصْلَحُ» خَبَرًا مَرْفُوعًا، وَيَخْتَلِفُ عَنْ فِعْلِ الْمَاضِي «أَصْلَحَ»."
      ],
      "synonyms": [],
      "antonyms": [],
      "collocations": [
        "الْحَلُّ الْأَصْلَحُ",
        "أَصْلَحُ مِنْ غَيْرِهِ"
      ],
      "examples_ar": [
        "هَذَا الْحَلُّ أَصْلَحُ لِلطُّلَّابِ مِنَ الْحَلِّ السَّابِقِ.",
        "اخْتَارَ الْمُدِيرُ الرَّأْيَ الْأَصْلَحَ لِلْمَدْرَسَةِ."
      ],
      "usage_note_ar": "«أَصْلَحُ» اسْمُ تَفْضِيلٍ، وَ«أَصْلَحَ» فِعْلٌ مَاضٍ؛ الْفَارِقُ فِي النُّطْقِ بَيْنَ صِيغَتَيْهِمَا هُوَ حَرَكَةُ الْحَرْفِ الْأَخِيرِ، فَلَا تُنْقَلُ تَصَارِيفُ الْفِعْلِ إِلَى بَابِ التَّفْضِيلِ.",
