    {
      "id": "bayna_print04_08_restored_20261118_001",
      "arabic": "أَجْهَلُ",
      "meaning_ar": "أَكْثَرُ جَهْلًا مِنْ غَيْرِهِ، أَوْ أَقَلُّ عِلْمًا بِأَمْرٍ مُعَيَّنٍ.",
      "additional_meanings_ar": [],
      "grammar": [
        "اِسْمُ تَفْضِيلٍ عَلَى وَزْنِ «أَفْعَلَ»، وَجَذْرُهُ: ج ـ ه ـ ل.",
        "يَأْتِي مَعَ «مِنْ» فِي الْمُقَارَنَةِ، وَقَدْ يُعَدَّى بِالْبَاءِ لِبَيَانِ مَوْضُوعِ الْجَهْلِ."
      ],
      "synonyms": [],
      "antonyms": [],
      "collocations": [
        "أَجْهَلُ بِالْمَسْأَلَةِ",
        "أَجْهَلُ مِنْ غَيْرِهِ"
      ],
      "examples_ar": [
        "هَذَا الطَّالِبُ أَجْهَلُ بِالْقَاعِدَةِ مِنْ زَمِيلِهِ.",
        "لَا تَقُلْ إِنَّ زَمِيلَكَ أَجْهَلُ مِنْكَ دُونَ دَلِيلٍ."
      ],
      "usage_note_ar": "«أَجْهَلُ» اسْمُ تَفْضِيلٍ، فَلَا يُخْلَطُ بِالْفِعْلِ الْمَاضِي «أَجْهَلَ»؛ فَالْحَرَكَةُ الْأَخِيرَةُ تُمَيِّزُ الْوَظِيفَةَ النَّحْوِيَّةَ.",
      "book_references": [],
      "sources": [
        "https://saaid.org/book/open.php?book=11997",
