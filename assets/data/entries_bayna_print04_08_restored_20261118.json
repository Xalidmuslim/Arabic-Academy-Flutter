    {
      "id": "bayna_print04_08_restored_20261118_002",
      "arabic": "أَجْيَالٌ",
      "meaning_ar": "جَمَاعَاتٌ مِنَ النَّاسِ تَتَعَاقَبُ فِي أَزْمِنَةٍ مُخْتَلِفَةٍ.",
      "additional_meanings_ar": [],
      "grammar": [
        "جَمْعُ تَكْسِيرٍ، وَمُفْرَدُهُ «جِيلٌ»، وَجَذْرُهُ: ج ـ ي ـ ل.",
        "يُسْتَعْمَلُ لِلْجَمَاعَاتِ الْمُتَعَاقِبَةِ الَّتِي تَعِيشُ فِي فَتَرَاتٍ مُخْتَلِفَةٍ."
      ],
      "synonyms": [],
      "antonyms": [],
      "collocations": [
        "الْأَجْيَالُ الْجَدِيدَةُ",
        "تَعَاقُبُ الْأَجْيَالِ"
      ],
      "examples_ar": [
        "تَعَاقَبَتْ أَجْيَالٌ عَلَى عِمَارَةِ هَذِهِ الْمَدِينَةِ.",
        "تَنْقُلُ الْأُسَرُ خِبْرَاتِهَا إِلَى الْأَجْيَالِ الْجَدِيدَةِ."
      ],
      "usage_note_ar": "«أَجْيَالٌ» جَمْعُ «جِيلٍ»، وَالْجِيلُ لَيْسَ مُرَادِفًا لِكُلِّ جَمَاعَةٍ مِنَ النَّاسِ؛ بَلْ يَرْتَبِطُ بِالتَّقَارُبِ الزَّمَنِيِّ.",
