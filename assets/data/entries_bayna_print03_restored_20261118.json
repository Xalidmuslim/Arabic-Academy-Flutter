    {
      "id": "bayna_print03_restored_20261118_002",
      "arabic": "أَثِيرٌ",
      "meaning_ar": "الْفَضَاءُ فِي تَعْبِيرِ «عَبْرَ الْأَثِيرِ» عِنْدَ الْحَدِيثِ عَنِ الْبَثِّ الْإِذَاعِيِّ.",
      "additional_meanings_ar": [
        "وَسَطٌ افْتِرَاضِيٌّ قَدِيمٌ فِي بَعْضِ التَّفْسِيرَاتِ الْفِيزِيَائِيَّةِ لِانْتِقَالِ الضَّوْءِ."
      ],
      "grammar": [
        "اِسْمٌ مُذَكَّرٌ عَلَى وَزْنِ «فَعِيلٍ»، وَجَذْرُهُ: أ ـ ث ـ ر.",
        "يَكْثُرُ اسْتِعْمَالُهُ مُعَرَّفًا بِـ«الْ» فِي التَّرْكِيبِ «عَبْرَ الْأَثِيرِ»."
      ],
      "synonyms": [],
      "antonyms": [],
      "collocations": [
        "الْبَثُّ عَبْرَ الْأَثِيرِ"
      ],
      "examples_ar": [
        "يَبُثُّ الْمُذِيعُ الْأَخْبَارَ عَبْرَ الْأَثِيرِ.",
        "يَرْتَبِطُ تَعْبِيرُ «عَبْرَ الْأَثِيرِ» بِالْبَثِّ الْإِذَاعِيِّ."
      ],
      "usage_note_ar": "«عَبْرَ الْأَثِيرِ» تَعْبِيرٌ إِذَاعِيٌّ شَائِعٌ، وَ«الْأَثِيرُ» فِي الْفِيزِيَاءِ الْقَدِيمَةِ اسْمٌ لِوَسَطٍ افْتِرَاضِيٍّ، لَا لِشَيْءٍ ثَابِتِ الْوُجُودِ.",
