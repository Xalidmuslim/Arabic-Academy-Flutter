    {
      "id": "bayna_print03_restored_20261118_001",
      "arabic": "إِثْمٌ",
      "meaning_ar": "ذَنْبٌ يَسْتَوْجِبُ الْعُقُوبَةَ عَلَى فَاعِلِهِ.",
      "additional_meanings_ar": [],
      "grammar": [
        "اِسْمٌ مُذَكَّرٌ، وَجَمْعُهُ: «آثَامٌ»، وَجَذْرُهُ: أ ـ ث ـ م.",
        "يَأْتِي «إِثْمٌ» مَصْدَرًا لِلْفِعْلِ «أَثِمَ يَأْثَمُ»، وَهُوَ عَلَى وَزْنِ «فِعْلٍ»."
      ],
      "synonyms": [],
      "antonyms": [],
      "collocations": [
        "اجْتِنَابُ الْإِثْمِ",
        "الْوُقُوعُ فِي الْإِثْمِ"
      ],
      "examples_ar": [
        "يَتَجَنَّبُ الْعَاقِلُ الْإِثْمَ وَالظُّلْمَ.",
        "اعْتَرَفَ الرَّجُلُ بِإِثْمِهِ وَطَلَبَ الْمَغْفِرَةَ."
      ],
      "usage_note_ar": "«إِثْمٌ» اِسْمٌ لِلذَّنْبِ، وَ«أَثِمَ» فِعْلٌ مَاضٍ، وَ«أَثِيمٌ» صِفَةٌ. وَجَمْعُ الْإِثْمِ «آثَامٌ».",
