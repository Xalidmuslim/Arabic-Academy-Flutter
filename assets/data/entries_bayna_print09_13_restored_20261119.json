    {
      "id": "bayna_print09_13_restored_20261119_001",
      "arabic": "أَذْوَاقٌ",
      "meaning_ar": "جَمْعُ «ذَوْقٍ»، وَيُرَادُ بِهِ تَعَدُّدُ طَرَائِقِ الْإِحْسَاسِ بِالطَّعْمِ أَوِ الْمَيْلِ إِلَى الْجَمَالِ وَالْفَنِّ.",
      "additional_meanings_ar": [
        "وَقَدْ يُسْتَعْمَلُ لِلْمُيُولِ الْمُخْتَلِفَةِ بَيْنَ النَّاسِ."
      ],
      "grammar": [
        "جَمْعُ تَكْسِيرٍ لِـ«ذَوْقٍ»، وَجَذْرُهُ: ذ ـ و ـ ق.",
        "الْمُفْرَدُ «ذَوْقٌ»، وَهُوَ اسْمٌ مُذَكَّرٌ؛ وَتَخْتَلِفُ دَلَالَتُهُ بِاخْتِلَافِ السِّيَاقِ."
      ],
      "synonyms": [],
      "antonyms": [],
      "collocations": [
        "أَذْوَاقٌ مُخْتَلِفَةٌ",
        "اخْتِلَافُ الْأَذْوَاقِ"
      ],
      "examples_ar": [
        "تَخْتَلِفُ أَذْوَاقُ النَّاسِ فِي اخْتِيَارِ الطَّعَامِ.",
        "احْتَرَمَ الْمُصَمِّمُ أَذْوَاقَ زَبَائِنِهِ الْمُخْتَلِفَةَ."
      ],
      "usage_note_ar": "«أَذْوَاقٌ» جَمْعُ «ذَوْقٍ»؛ فَذَوْقُ الطَّعَامِ يَتَعَلَّقُ بِحَاسَّةٍ، وَالذَّوْقُ الْفَنِّيُّ يَتَعَلَّقُ بِالِاسْتِحْسَانِ، وَلَا يَتَّحِدُ الْمَعْنَيَانِ.",
