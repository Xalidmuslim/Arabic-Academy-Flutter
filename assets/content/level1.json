    {
      "id": "l1",
      "title": "Приветствие и имя",
      "title_ar": "التَّحِيَّةُ وَالاسْمُ",
      "goal": "Поздороваться и представиться",
      "dialogue": [
        {
          "ar": "سَلْمَى: السَّلَامُ عَلَيْكُمْ.",
          "ru": "Сальма: Мир вам."
        },
        {
          "ar": "مَرْيَمُ: وَعَلَيْكُمُ السَّلَامُ.",
          "ru": "Марьям: И вам мир."
        },
        {
          "ar": "سَلْمَى: أَنَا سَلْمَى. مَا اسْمُكِ؟",
          "ru": "Сальма: Я Сальма. Как тебя зовут?"
        },
        {
          "ar": "مَرْيَمُ: اسْمِي مَرْيَمُ.",
          "ru": "Марьям: Меня зовут Марьям."
        }
      ],
      "vocabulary": [
        {
          "ar": "اسْمٌ",
          "ru": "Имя"
        },
        {
          "ar": "مَرْحَبًا",
          "ru": "Добро пожаловать"
        },
        {
          "ar": "أَنَا",
          "ru": "Я"
        }
      ],
      "grammar": "اسْمِي — «меня зовут». Местоимение ـي означает «мой/моя».",
      "question": "Как переводится «مَا اسْمُكِ؟»?",
      "options": [
        "Где твоя книга?",
        "Как тебя зовут?",
        "Откуда ты?"
      ],
      "correct": 1,
      "homework": "Представьтесь на арабском языке двумя предложениями."
    },
    {
